# ============================================
# FinTrack — Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================

# --- Database ---
# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/fintrack
DATABASE_URL=

# --- Authentication (Better Auth) ---
# Secret used for signing sessions/tokens. Generate a strong random string.
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the application (used by Better Auth for callbacks)
BETTER_AUTH_URL=http://localhost:3000

# --- WhatsApp Cloud API (Phase 4) ---
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v22.0

# --- LLM API (Phase 5) ---
# LLM_API_KEY=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
